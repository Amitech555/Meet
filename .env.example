# Copier en .env (jamais commité). Seules les variables EXPO_PUBLIC_* sont lues par l'app.

# Supabase — `npx supabase status` en local donne ces valeurs
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Recherche d'adresses (Mapbox Geocoding) — jeton public pk.*
EXPO_PUBLIC_MAPBOX_TOKEN=
# Style de carte MapLibre (OpenFreeMap par défaut, sans clé)
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Analytics / crashs
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# Connexion Google (ID client OAuth « Web » utilisé par Supabase)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Domaine des liens de partage (universal links + page Open Graph)
EXPO_PUBLIC_SHARE_BASE_URL=https://partants.app

# --- Côté serveur uniquement (Edge Functions : `supabase secrets set`) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EXPO_ACCESS_TOKEN=
