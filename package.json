    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "db:test": "bash scripts/db-test.sh",
    "db:reset": "bash scripts/reset-db.sh",
    "screens": "node scripts/screenshots.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
