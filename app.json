{
  "expo": {
    "name": "Partants",
    "slug": "meet",
    "scheme": "partants",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF7F2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.partants.mobile",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:partants.app"],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pour te montrer les sessions près de toi. Ta position exacte n'est jamais partagée.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Pour ajouter tes sessions à ton calendrier."
      }
    },
    "android": {
      "package": "app.partants.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FF4F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "partants.app", "pathPrefix": "/s/" }, { "scheme": "https", "host": "partants.app", "pathPrefix": "/g/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#FAF7F2", "dark": { "backgroundColor": "#0F0E0D" } }],
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      ["expo-location", { "locationWhenInUsePermission": "Pour te montrer les sessions près de toi. Ta position exacte n'est jamais partagée." }],
      ["expo-notifications", { "color": "#FF4F1A" }],
      ["expo-calendar", { "calendarPermission": "Pour ajouter tes sessions à ton calendrier." }],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
